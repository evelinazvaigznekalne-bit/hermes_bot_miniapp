# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
#   cp .env.example .env
#   nano .env
#
# Every value below is a placeholder. The application detects placeholder
# values and treats the corresponding subsystem as UNCONFIGURED rather than
# silently using them.
# ---------------------------------------------------------------------------

# --- Telegram Bot (from @BotFather) ----------------------------------------
# Leave unset to run the Mini App server only; bot polling and initData
# validation will fail closed.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Public HTTPS URL of the Mini App (required by Telegram to open the web app).
TELEGRAM_WEBAPP_URL=https://example.com

# --- tunnel ---------------------------------------------------------
# quick = random trycloudflare.com URL that changes every restart
# named = permanent URL on a domain you own (run scripts/tunnel_setup.sh)
TUNNEL_MODE=quick
TUNNEL_NAME=hermesgotdat
# TUNNEL_HOSTNAME=bot.your-domain.com
# TUNNEL_ID=  (set automatically by scripts/tunnel_setup.sh)
# Bot display name. Applied via the Bot API by scripts/register_miniapp.sh.
# The @username is fixed at creation and can only be changed by @BotFather.
BOT_DISPLAY_NAME=hermesgotdat

# --- MemePol puzzle dataset (authorized access only) -----------------------
MEMEPOL_API_KEY=YOUR_MEMEPOL_API_KEY
MEMEPOL_AUTH_HEADER=X-API-Key
MEMEPOL_AUTH_PREFIX=
MEMEPOL_BASE_URL=https://api.memepol.example/v1

# --- Chain endpoints --------------------------------------------------------
# Optional. Comma-separated, tried in order. Public read-only fallbacks are
# built in, so this is only needed for a private/paid node.
ETH_RPC_URL=
BTC_API_BASE=https://mempool.space/api

# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
HTTP_TIMEOUT=12

# --- Auth -------------------------------------------------------------------
# Seconds a signing challenge stays valid.
NONCE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20

# --- Logging ----------------------------------------------------------------
LOG_DIR=./logs
